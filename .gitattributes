# Git Bash / Linux par shell scripts LF line-endings se hi chalti hain.
# CRLF hone par "bad interpreter: /usr/bin/env bash^M" error aa jaata hai.
# Sirf utahi files - baaki (.java, .ps1) ko haath nahi lagaya jaata.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows batch file ko CRLF chahiye, warna cmd.exe kaam karna chhod deta hai
*.bat  text eol=crlf